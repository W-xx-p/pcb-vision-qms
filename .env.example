# Legacy single administrator key. Prefer PCB_QMS_API_KEYS in shared environments.
PCB_QMS_API_KEY=
# JSON map: secret -> operator identity and role.
# Roles: admin, engineer, inspector, reviewer, auditor, integration
PCB_QMS_API_KEYS=
# Set to 1 behind HTTPS so the browser session cookie is Secure.
PCB_QMS_SECURE_COOKIES=0
PCB_QMS_ENV=production
PCB_QMS_RATE_LIMIT_PER_MINUTE=120
PCB_QMS_OIDC_ISSUER=
PCB_QMS_OIDC_JWKS_URL=
PCB_QMS_OIDC_AUDIENCE=pcb-qms
PCB_QMS_OIDC_ROLE_CLAIM=roles
PCB_QMS_MODEL_GATE_MIN_SAMPLES=20
PCB_QMS_MODEL_GATE_MIN_F1=0.85
PCB_QMS_MODEL_GATE_MIN_RECALL=0.90
PCB_QMS_MODEL_GATE_MAX_FPR=0.10
PCB_QMS_DRIFT_MIN_SAMPLES=30
PCB_QMS_DRIFT_PSI_THRESHOLD=0.20
PCB_QMS_DRIFT_INTERVAL_SECONDS=3600
PCB_QMS_AUTO_RETRAIN=0
PCB_QMS_MES_WEBHOOK_URL=
PCB_QMS_MES_WEBHOOK_TOKEN=
PCB_QMS_PLC_HOST=
PCB_QMS_PLC_PORT=502
PCB_QMS_PLC_UNIT_ID=1
PCB_QMS_PLC_RESULT_REGISTER=100
GRAFANA_ADMIN_USER=qmsadmin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
PCB_QMS_BACKUP_INTERVAL_SECONDS=86400
PCB_QMS_DATA_DIR=/app/data
PCB_QMS_DATABASE_URL=postgresql+psycopg://pcb_qms:replace-with-a-strong-password@postgres:5432/pcb_qms
PCB_QMS_IMAGE_SIZE=256
PCB_QMS_HTTP_PORT=8013
PCB_QMS_POSTGRES_PORT=5433
PCB_QMS_REDIS_URL=redis://redis:6379/0
PCB_QMS_MINIO_ENDPOINT=minio:9000
PCB_QMS_MINIO_ACCESS_KEY=qmsadmin
PCB_QMS_MINIO_SECRET_KEY=qms-change-this-password
PCB_QMS_MINIO_BUCKET=pcb-qms
PCB_QMS_MINIO_SECURE=0
MINIO_ROOT_USER=qmsadmin
MINIO_ROOT_PASSWORD=qms-change-this-password
POSTGRES_PASSWORD=replace-with-a-strong-password
